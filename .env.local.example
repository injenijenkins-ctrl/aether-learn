# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth.js / NextAuth (REQUIRED on Vercel — session returns 500 without these)
# Generate secret: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# Production: your live URL (e.g. https://your-app.vercel.app)
# Local: http://localhost:3000
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000

# Optional on Vercel if AUTH_URL is set correctly
# AUTH_TRUST_HOST=true

# Google OAuth (at least one provider required to sign in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI provider keys are configured in the app Settings UI (not stored here)
